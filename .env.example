# ==================================================
# UCP Shopping Agent - Environment Variables
# ==================================================
# Copy this to .env and fill in your values

ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ENVIRONMENT=development

# --- Observability (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=ucp-shopping-agent

# --- Application ---
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Security ---
# Required for POST /api/v1/merchants/discover (send as X-API-Key). Empty = endpoint disabled.
ADMIN_API_KEY=
# Comma-separated browser origins allowed to call the API. Empty = none.
CORS_ALLOW_ORIGINS=
# Merchants outside KNOWN_MERCHANT_URLS must be public https hosts. Set true only on a trusted network.
ALLOW_PRIVATE_MERCHANT_HOSTS=false
# Show internal error text in 500 responses (debugging only).
EXPOSE_ERROR_DETAILS=false
MAX_ACTIVE_SESSIONS=500
